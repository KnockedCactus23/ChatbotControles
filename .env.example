# Copia este archivo como .env y pon tu API key de Claude (platform.claude.com → API keys).
ANTHROPIC_API_KEY=tu_api_key_aqui
# Modelo. claude-sonnet-5-5 para las corridas que se entregan; claude-haiku-5-5 para depurar por centavos.
# Usa un solo modelo en toda una evaluación (la consistencia es parte de la rúbrica).
CLAUDE_MODEL=claude-sonnet-5-5
